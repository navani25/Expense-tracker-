# ==========================================
# LEDGERLY EXPENSE TRACKER - ENVIRONMENT CONFIG
# ==========================================

# ------------------------------------------
# FRONTEND CONFIGURATION (Safe to expose to browser)
# ------------------------------------------
# API Base URL for backend communications
# Development default: http://localhost:8000/api
# Production example: https://api.yourdomain.com/api
VITE_API_BASE_URL="http://localhost:8000/api"

# Google OAuth Web Client ID
VITE_GOOGLE_CLIENT_ID="your_google_web_client_id.apps.googleusercontent.com"

# Google OAuth Android Client ID (for Capacitor Android builds)
VITE_GOOGLE_ANDROID_CLIENT_ID="your_google_android_client_id.apps.googleusercontent.com"


# ------------------------------------------
# BACKEND CONFIGURATION (SERVER SECRETS ONLY - NEVER EXPOSE TO FRONTEND)
# ------------------------------------------
# Google Gemini AI API Key (Used strictly on backend server)
GEMINI_API_KEY="your_gemini_api_key_here"

# JWT Secret Key used for signing user session tokens
JWT_SECRET="your_strong_random_jwt_secret_key_here"

# Backend server port (Default: 8000)
PORT=8000

# Allowed CORS origins for production (comma-separated if multiple)
# Example: https://yourdomain.com,https://app.yourdomain.com
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,capacitor://localhost"
